# Copy to .env and fill in what you want. Every key is optional.

# Better resume parsing and tailored cover letters (resume text is sent to OpenAI).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# US (and 18 other countries) job search by city across many job sites. Free key: https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# US federal jobs. Free key: https://developer.usajobs.gov/apirequest/
# USAJOBS_USER_AGENT must be the email address you registered with.
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=

# Send applications by email when a posting lists an address.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Run the pre-fill browser without a window (testing only; you can't review a hidden form).
FORMFILL_HEADLESS=false

# Keep the database, uploads, and browser profile somewhere other than ./data
# JOBAPPLY_DATA_DIR=
