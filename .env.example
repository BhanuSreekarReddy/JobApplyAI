# Copy to .env and fill in what you want. Every key is optional.

# Better resume parsing and tailored cover letters (resume text is sent to OpenAI).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# US (and 18 other countries) job search by city across many job sites. Free key: https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# US federal jobs. Free key: https://developer.usajobs.gov/apirequest/
# USAJOBS_USER_AGENT must be the email address you registered with.
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=

# Send applications by email when a posting lists an address. In hosted
# mode (below) the same SMTP_* settings also send the account emails:
# email verification and password reset.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Hosted mode: user accounts, seeded admins, invite-only signup ---
# Set JOBAPPLY_HOSTED=true to require an account for everything except the
# public home page. See "Running it hosted" in README.md for the full setup,
# including how to create the Gmail App Password used as SMTP_PASSWORD.
JOBAPPLY_HOSTED=false
# Comma-separated emails. Anyone who registers with one of these addresses
# becomes an admin; seeded admins can't be demoted, deactivated, or deleted.
ADMIN_EMAILS=
# Optional one-time invite code created at startup so the very first
# (admin) account can register while registration is invite-only.
JOBAPPLY_BOOTSTRAP_INVITE=
# Max runs a non-admin user can start per day.
MAX_RUNS_PER_DAY=20
# Set true when the app is served over HTTPS so the session cookie is
# only sent over secure connections.
SESSION_COOKIE_SECURE=false
# Public origin (scheme + host) the app is opened at. Verification and
# password-reset emails build their links from it, so hosted deployments
# must set it to the public address, e.g. https://jobapplylive.com.
PUBLIC_BASE_URL=http://localhost:5173
# Browser origins allowed to call the API, comma-separated. Defaults to the
# local Vite dev server; hosted deployments must set it to the public
# frontend origin, e.g. https://jobapplylive.com, or the browser will block
# the frontend from calling the API at all.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Hosted deployments should use Postgres instead of the local SQLite file:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/jobapply

# Run the pre-fill browser without a window (testing only; you can't review a hidden form).
FORMFILL_HEADLESS=false

# Keep the database, uploads, and browser profile somewhere other than ./data
# JOBAPPLY_DATA_DIR=
